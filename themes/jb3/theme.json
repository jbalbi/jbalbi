{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Fondo", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Texto", "color": "#1a1a1a" },
				{ "slug": "primary", "name": "Primario", "color": "#2457d6" },
				{ "slug": "secondary", "name": "Secundario", "color": "#f2f4f8" },
				{ "slug": "muted", "name": "Atenuado", "color": "#6b7280" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Sistema",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monoespaciada",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeño", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Mediano", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grande", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Muy grande", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Enorme", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 6rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "6px" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--contrast)" }
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "background": "var(--wp--preset--color--secondary)" },
				"spacing": { "padding": { "top": "1rem", "right": "1rem", "bottom": "1rem", "left": "1rem" } }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	]
}
