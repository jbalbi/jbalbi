# Bloquea el acceso directo por HTTP a archivos de log — wp-config.php
# puede tener WP_DEBUG_LOG activo (útil en desarrollo), y sin esto
# wp-content/debug.log queda descargable tal cual por cualquiera
# (auditoría de seguridad 2026-08-27). Viaja con el repo a cualquier
# servidor, así que protege sin depender de que cada wp-config.php tenga
# el debug apagado.
<FilesMatch "\.log$">
	Require all denied
</FilesMatch>

# Bloquea el acceso directo por HTTP a cualquier PDF (revisión pre-producción
# 2026-10-01). Hoy los únicos PDF del sitio son los de Op. Comerciales, que
# son contenido para usuarios registrados: se sirven SOLO por PHP, con
# sesión + nonce (ver JB3_Op_Comerciales_Tracking::handle_pdf() en
# jb3-members, y la acción AJAX jb3_pdf_admin en _init_pdf_preview_admin.php para el
# editor). Sin esto, la URL real de uploads/ se bajaba sin login para
# siempre. OJO: si algún día se necesita un PDF público (ej. un press kit),
# linkearlo desde fuera de wp-content o sumar una excepción acá.
<FilesMatch "(?i)\.pdf$">
	Require all denied
</FilesMatch>

# ─── Endurecimiento (revisión de seguridad 2026-10-09) ──────────────────────
# Sin listado de carpetas: /wp-content/uploads/ o /plugins/jb3-members/
# mostraban todos los archivos que contienen.
Options -Indexes

# Ningún archivo ni carpeta "oculta" (empieza con punto) se sirve por web:
# .git (el repositorio entero, historial incluido, era descargable), .claude,
# .gitignore, etc. Devuelve 404 para no confirmar siquiera que existen.
RedirectMatch 404 "/\.(?!well-known/)[^/]*(/|$)"

# Archivos internos que no son para el público: documentación de los
# plugins, definiciones de campos ACF (acf-json), la base de GeoIP (64 MB) y
# respaldos o volcados que pudieran quedar por error.
<FilesMatch "(?i)(\.(md|mmdb|sql|bak|old|orig|swp|dist)|^group_[a-z0-9_]+\.json)$">
	Require all denied
</FilesMatch>
